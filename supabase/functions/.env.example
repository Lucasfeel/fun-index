# Optional overrides for local Edge Function development.
# Default Supabase secrets such as SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY
# are provided by the local stack and hosted functions automatically.

# PizzINT
# PIZZINT_API_BASE_URL=https://example.com/api/indicator
PIZZINT_API_KEY=replace-me

# CNN Fear & Greed
# CNN_FNG_ENDPOINT=https://production.dataviz.cnn.io/index/fearandgreed/graphdata

# CoinMarketCap
# CMC_API_BASE_URL=https://pro-api.coinmarketcap.com/v1/global-metrics/quotes/latest
CMC_API_KEY=replace-me

# SNS connector
# SNS_CONNECTOR_BASE_URL=https://example.com/api/social-rollup
SNS_CONNECTOR_BEARER_TOKEN=replace-me
ADMIN_PASSWORD=change-this-admin-password

# Card alert notifications
TOSS_API_BASE_URL=https://apps-in-toss-api.toss.im
TOSS_SMART_MESSAGE_TEMPLATE_SET_CODE=replace-me
ALERT_SESSION_SECRET=replace-with-long-random-session-secret
ALERT_DISPATCH_SECRET=replace-with-long-random-dispatch-secret
